{% if section.settings.enabled %}
<section class="pop-up-venue" style="background-color: {{ section.settings.bg_color }}; padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="pop-up-venue__inner {% if section.settings.image_position == 'right' %}pop-up-venue__inner--reversed{% endif %}">
    <div class="pop-up-venue__image-col">
      {% if section.settings.venue_image != blank %}
        <img
          src="{{ section.settings.venue_image | image_url: width: 800 }}"
          srcset="{{ section.settings.venue_image | image_url: width: 400 }} 400w,
                  {{ section.settings.venue_image | image_url: width: 600 }} 600w,
                  {{ section.settings.venue_image | image_url: width: 800 }} 800w"
          sizes="(min-width: 768px) 50vw, 100vw"
          alt="{{ section.settings.venue_image.alt | escape }}"
          loading="lazy"
          class="pop-up-venue__image"
        >
      {% endif %}
    </div>
    <div class="pop-up-venue__text-col">
      {% if section.settings.heading != blank %}
        <h2 class="pop-up-venue__heading" style="color: {{ section.settings.heading_color }}; font-size: {{ section.settings.heading_size }}px;">{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.body != blank %}
        <div class="pop-up-venue__body" style="color: {{ section.settings.text_color }};">{{ section.settings.body }}</div>
      {% endif %}
      {% if section.settings.directions_url != blank %}
        <a href="{{ section.settings.directions_url }}" target="_blank" rel="noopener" class="pop-up-venue__directions" style="color: {{ section.settings.link_color }};">
          {{ section.settings.directions_text | default: 'Get Directions' }} &rarr;
        </a>
      {% endif %}
    </div>
  </div>
</section>
{% endif %}

<style>
  .pop-up-venue {
    width: 100%;
    padding-left: 40px;
    padding-right: 40px;
  }

  .pop-up-venue__inner {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: center;
  }

  .pop-up-venue__inner--reversed .pop-up-venue__image-col {
    order: 2;
  }

  .pop-up-venue__inner--reversed .pop-up-venue__text-col {
    order: 1;
  }

  .pop-up-venue__image {
    width: 100%;
    height: auto;
    display: block;
  }

  .pop-up-venue__text-col {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .pop-up-venue__heading {
    font-family: var(--font_header), sans-serif;
    font-weight: 400;
    margin: 0;
  }

  .pop-up-venue__body {
    font-family: var(--font_body), sans-serif;
    font-size: 15px;
    line-height: 1.7;
  }

  .pop-up-venue__body p {
    margin: 0 0 12px 0;
  }

  .pop-up-venue__body p:last-child {
    margin-bottom: 0;
  }

  .pop-up-venue__directions {
    font-family: var(--font_body), sans-serif;
    font-size: 14px;
    letter-spacing: 1px;
    text-decoration: none;
    text-transform: uppercase;
    transition: opacity 0.2s ease;
  }

  .pop-up-venue__directions:hover {
    opacity: 0.7;
  }

  @media screen and (max-width: 768px) {
    .pop-up-venue {
      padding-left: 20px;
      padding-right: 20px;
    }

    .pop-up-venue__inner,
    .pop-up-venue__inner--reversed {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .pop-up-venue__inner--reversed .pop-up-venue__image-col,
    .pop-up-venue__inner--reversed .pop-up-venue__text-col {
      order: unset;
    }

    .pop-up-venue__heading {
      font-size: 22px !important;
    }
  }
</style>

{% schema %}
{
  "name": "Pop-Up Venue Info",
  "settings": [
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "Show This Section",
      "default": true
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "image_picker",
      "id": "venue_image",
      "label": "Venue Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Venue"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Description",
      "default": "<p>Located in the heart of Los Angeles. Street parking available. Nearest cross streets and transit info.</p>"
    },
    {
      "type": "url",
      "id": "directions_url",
      "label": "Directions Link"
    },
    {
      "type": "text",
      "id": "directions_text",
      "label": "Directions Link Text",
      "default": "Get Directions"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image Position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f7f5ec"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#191818"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#191818"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Directions Link Color",
      "default": "#191818"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top Padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom Padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading Size",
      "min": 18,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 28
    }
  ],
  "presets": [
    {
      "name": "Pop-Up Venue Info",
      "category": "Pop-Up Shop"
    }
  ]
}
{% endschema %}
