<section class="pop-up-rsvp" style="background-color: {{ section.settings.bg_color }}; padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="pop-up-rsvp__inner">
    {% if section.settings.heading != blank %}
      <h2 class="pop-up-rsvp__heading" style="color: {{ section.settings.heading_color }}; font-size: {{ section.settings.heading_size_desktop }}px;">{{ section.settings.heading }}</h2>
    {% endif %}

    {% if section.settings.message != blank %}
      <p class="pop-up-rsvp__message" style="color: {{ section.settings.text_color }};">{{ section.settings.message }}</p>
    {% endif %}

    {%- form 'customer', class: 'pop-up-rsvp__form' -%}
      {% if form.errors %}
        <div class="pop-up-rsvp__error">{{ form.errors | default_errors }}</div>
      {% endif %}

      {% if form.posted_successfully? %}
        <div class="pop-up-rsvp__success" style="color: {{ section.settings.success_color }};">
          {{ section.settings.success_message }}
        </div>
      {% else %}
        <input type="hidden" name="contact[tags]" value="pop-up-rsvp, la-pop-up">
        <div class="pop-up-rsvp__fields">
          <input
            type="email"
            name="contact[email]"
            id="PopUpRsvpEmail"
            class="pop-up-rsvp__input"
            placeholder="{{ section.settings.placeholder }}"
            required
            autocomplete="email"
            style="background-color: {{ section.settings.input_bg }}; color: {{ section.settings.input_text_color }}; border-color: {{ section.settings.input_border_color }};"
          >
          <button type="submit" class="pop-up-rsvp__submit" style="background-color: {{ section.settings.button_bg }}; color: {{ section.settings.button_text_color }};">
            {{ section.settings.button_text }}
          </button>
        </div>
      {% endif %}
    {%- endform -%}

    {% if section.settings.closing_text != blank %}
      <p class="pop-up-rsvp__closing" style="color: {{ section.settings.text_color }}; font-size: {{ section.settings.closing_size_desktop }}px;">{{ section.settings.closing_text }}</p>
    {% endif %}
  </div>
</section>

<style>
  .pop-up-rsvp {
    width: 100%;
    padding-left: 40px;
    padding-right: 40px;
  }

  .pop-up-rsvp__inner {
    max-width: 560px;
    margin: 0 auto;
    text-align: center;
  }

  .pop-up-rsvp__heading {
    font-family: var(--font_header), sans-serif;
    font-weight: 400;
    margin: 0 0 12px 0;
  }

  .pop-up-rsvp__message {
    font-family: var(--font_body), sans-serif;
    font-size: 15px;
    line-height: 1.6;
    margin: 0 0 28px 0;
    opacity: 0.8;
  }

  .pop-up-rsvp__form {
    margin: 0 auto 32px;
  }

  .pop-up-rsvp__fields {
    display: flex;
    gap: 10px;
    justify-content: center;
  }

  .pop-up-rsvp__input {
    flex: 1;
    max-width: 360px;
    padding: 12px 20px;
    border: 1px solid;
    font-family: var(--font_body), sans-serif;
    font-size: 15px;
    outline: none;
    transition: border-color 0.2s ease;
  }

  .pop-up-rsvp__input:focus {
    border-color: #191818;
  }

  .pop-up-rsvp__input::placeholder {
    opacity: 0.5;
  }

  .pop-up-rsvp__submit {
    padding: 12px 24px;
    border: none;
    font-family: var(--btn_font), sans-serif;
    font-size: 13px;
    letter-spacing: 1px;
    text-transform: uppercase;
    cursor: pointer;
    transition: opacity 0.2s ease;
    white-space: nowrap;
  }

  .pop-up-rsvp__submit:hover {
    opacity: 0.85;
  }

  .pop-up-rsvp__error {
    color: #ee4444;
    margin-bottom: 16px;
    font-family: var(--font_body), sans-serif;
    font-size: 14px;
  }

  .pop-up-rsvp__success {
    margin-bottom: 16px;
    font-family: var(--font_body), sans-serif;
    font-size: 15px;
    padding: 12px;
  }

  .pop-up-rsvp__closing {
    font-family: var(--font_header), sans-serif;
    font-weight: 400;
    margin: 0;
    line-height: 1.2;
  }

  @media screen and (max-width: 768px) {
    .pop-up-rsvp {
      padding-left: 20px;
      padding-right: 20px;
    }

    .pop-up-rsvp__heading {
      font-size: {{ section.settings.heading_size_mobile }}px !important;
    }

    .pop-up-rsvp__fields {
      flex-direction: column;
    }

    .pop-up-rsvp__input {
      max-width: none;
      width: 100%;
    }

    .pop-up-rsvp__submit {
      width: 100%;
    }

    .pop-up-rsvp__closing {
      font-size: {{ section.settings.closing_size_mobile }}px !important;
    }
  }
</style>

{% schema %}
{
  "name": "Pop-Up RSVP",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Get Reminded"
    },
    {
      "type": "text",
      "id": "message",
      "label": "Message",
      "default": "Drop your email and we'll remind you before the pop-up."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Input Placeholder",
      "default": "EMAIL"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "NOTIFY ME"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success Message",
      "default": "You're on the list. See you in LA."
    },
    {
      "type": "text",
      "id": "closing_text",
      "label": "Closing Text",
      "default": "See You in LA"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f7f5ec"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#191818"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#191818"
    },
    {
      "type": "color",
      "id": "input_bg",
      "label": "Input Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "input_text_color",
      "label": "Input Text Color",
      "default": "#191818"
    },
    {
      "type": "color",
      "id": "input_border_color",
      "label": "Input Border Color",
      "default": "#d0d0d0"
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "Button Background",
      "default": "#191818"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text Color",
      "default": "#f7f5ec"
    },
    {
      "type": "color",
      "id": "success_color",
      "label": "Success Message Color",
      "default": "#191818"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top Padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom Padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_size_desktop",
      "label": "Heading Size (Desktop)",
      "min": 18,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading Size (Mobile)",
      "min": 16,
      "max": 36,
      "step": 2,
      "unit": "px",
      "default": 22
    },
    {
      "type": "range",
      "id": "closing_size_desktop",
      "label": "Closing Text Size (Desktop)",
      "min": 20,
      "max": 72,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "closing_size_mobile",
      "label": "Closing Text Size (Mobile)",
      "min": 18,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 28
    }
  ],
  "presets": [
    {
      "name": "Pop-Up RSVP",
      "category": "Pop-Up Shop"
    }
  ]
}
{% endschema %}
