{%- liquid
  assign col = section.settings.collection
  if col == blank
    assign col = collections['innanetape']
  endif
  if col == blank or col.products.size == 0
    assign col = collections.all
  endif
-%}
<section class="inn-featured">
  <a class="inn-label" href="{{ col.url }}">{{ section.settings.label | default: 'Shop' }}&gt;</a>
  <div class="inn-grid inn-grid--row">
    {%- comment -%} In-stock products lead the row; sold-out ones only fill what is left. {%- endcomment -%}
    {%- assign shown = 0 -%}
    {%- for product in col.products limit: 50 -%}
      {%- if product.available and shown < section.settings.limit -%}
        {% render 'inn-card', product: product %}
        {%- assign shown = shown | plus: 1 -%}
      {%- endif -%}
    {%- endfor -%}
    {%- for product in col.products limit: 50 -%}
      {%- unless product.available -%}
        {%- if shown < section.settings.limit and product.price > 0 -%}
          {% render 'inn-card', product: product %}
          {%- assign shown = shown | plus: 1 -%}
        {%- endif -%}
      {%- endunless -%}
    {%- endfor -%}
  </div>
  <a class="inn-label inn-featured__more" href="{{ section.settings.more_url | default: routes.all_products_collection_url }}">More&gt;</a>
</section>

{% schema %}
{
  "name": "Innanet product row",
  "settings": [
    { "type": "text", "id": "label", "label": "Label", "default": "Shop" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "label": "Products", "min": 2, "max": 8, "step": 2, "default": 4 },
    { "type": "url", "id": "more_url", "label": "More link" }
  ],
  "presets": [{ "name": "Innanet product row" }]
}
{% endschema %}
