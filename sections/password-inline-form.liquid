{% assign pjCnfg = section.settings %}

<div class="password-inline-section" style="background-color: {{ pjCnfg.background_color }};">
  <div class="password-inline-container">
    {% if pjCnfg.header != blank %}
      <h2 class="password-inline-header" style="color: {{ pjCnfg.heading_color }};">{{ pjCnfg.header }}</h2>
    {% endif %}

    {%- form 'storefront_password', class: 'password-inline-form' -%}
      {% if form.errors %}
        <div class="password-inline-error">
          {{ form.errors | default_errors }}
        </div>
      {% endif %}

      <div class="password-inline-fields">
        <input
          class="password-inline-input"
          name="password"
          type="password"
          placeholder="{{ pjCnfg.input_placeholder }}"
          style="
            background-color: {{ pjCnfg.input_background }};
            color: {{ pjCnfg.input_text }};
            border-radius: {{ pjCnfg.input_radius }}px;
          "
        >
        <input
          class="password-inline-submit"
          type="submit"
          value="{{ pjCnfg.button_text }}"
          style="
            background-color: {{ pjCnfg.button_background }};
            color: {{ pjCnfg.button_text_color }};
            border-radius: {{ pjCnfg.button_radius }}px;
          "
        >
      </div>
    {%- endform -%}
  </div>
</div>

<style>
  .password-inline-section {
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    padding-top: {{ pjCnfg.padding_top_desktop }}px;
    padding-bottom: {{ pjCnfg.padding_bottom_desktop }}px;
    padding-left: 2rem;
    padding-right: 2rem;
  }

  .password-inline-container {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    width: 100%;
    max-width: 800px;
  }

  .password-inline-header {
    margin: 0 0 {{ pjCnfg.header_margin_bottom }}px 0;
    font-size: {{ pjCnfg.title_size_desktop }}px;
    font-weight: {{ pjCnfg.title_weight }};
    text-align: center;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .password-inline-form {
    width: 100%;
    max-width: {{ pjCnfg.form_max_width }}px;
  }

  .password-inline-fields {
    display: flex;
    gap: {{ pjCnfg.field_gap }}px;
    justify-content: center;
    align-items: stretch;
  }

  .password-inline-input {
    flex: 1;
    padding: {{ pjCnfg.input_padding_vertical }}px {{ pjCnfg.input_padding_horizontal }}px;
    border: none;
    font-size: {{ pjCnfg.input_font_size }}px;
    font-family: var(--btn_font), sans-serif;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    min-width: 0;
  }

  .password-inline-input::placeholder {
    color: {{ pjCnfg.input_placeholder_color }};
  }

  .password-inline-input:focus {
    outline: none;
  }

  .password-inline-submit {
    padding: {{ pjCnfg.input_padding_vertical }}px {{ pjCnfg.button_padding_horizontal }}px;
    border: none;
    font-size: {{ pjCnfg.button_font_size }}px;
    font-family: var(--btn_font), sans-serif;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    cursor: pointer;
    transition: background-color 0.3s ease;
    white-space: nowrap;
  }

  .password-inline-submit:hover {
    background-color: {{ pjCnfg.button_background | color_modify: 'lightness', -10 }};
  }

  .password-inline-error {
    color: #ee4444;
    margin-bottom: 15px;
    text-align: center;
    font-size: 14px;
  }

  @media screen and (max-width: 600px) {
    .password-inline-section {
      padding-top: {{ pjCnfg.padding_top_mobile }}px;
      padding-bottom: {{ pjCnfg.padding_bottom_mobile }}px;
      padding-left: 1.5rem;
      padding-right: 1.5rem;
    }

    .password-inline-header {
      font-size: {{ pjCnfg.title_size_mobile }}px;
    }

    .password-inline-fields {
      flex-direction: column;
      gap: 10px;
    }

    .password-inline-input {
      width: 100%;
      text-align: center;
    }

    .password-inline-submit {
      width: 100%;
    }
  }
</style>

{% schema %}
{
  "name": "Inline Password Form",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "header",
      "label": "Header Text",
      "default": "EARLY ACCESS"
    },
    {
      "type": "text",
      "id": "input_placeholder",
      "label": "Input Placeholder",
      "default": "PASSWORD"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "ENTER"
    },

    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section Background Color",
      "default": "#E8A621"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Text Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "input_background",
      "label": "Input Background Color",
      "default": "#FAF4E8"
    },
    {
      "type": "color",
      "id": "input_text",
      "label": "Input Text Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "input_placeholder_color",
      "label": "Input Placeholder Color",
      "default": "#666666"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Button Background Color",
      "default": "#B91C1C"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text Color",
      "default": "#FFFFFF"
    },

    {
      "type": "header",
      "content": "Styling"
    },
    {
      "type": "range",
      "id": "input_radius",
      "label": "Input Corner Radius",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "button_radius",
      "label": "Button Corner Radius",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "form_max_width",
      "label": "Form Max Width",
      "min": 300,
      "max": 800,
      "step": 10,
      "unit": "px",
      "default": 600
    },
    {
      "type": "range",
      "id": "field_gap",
      "label": "Gap Between Input and Button",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 0
    },

    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Top Padding (Desktop)",
      "min": 0,
      "max": 200,
      "step": 5,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Bottom Padding (Desktop)",
      "min": 0,
      "max": 200,
      "step": 5,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top Padding (Mobile)",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom Padding (Mobile)",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "header_margin_bottom",
      "label": "Header Bottom Spacing",
      "min": 10,
      "max": 80,
      "step": 5,
      "unit": "px",
      "default": 40
    },

    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size_desktop",
      "label": "Header Size (Desktop)",
      "min": 16,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "title_size_mobile",
      "label": "Header Size (Mobile)",
      "min": 14,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "select",
      "id": "title_weight",
      "label": "Header Font Weight",
      "options": [
        {
          "value": "400",
          "label": "Regular"
        },
        {
          "value": "700",
          "label": "Bold"
        },
        {
          "value": "900",
          "label": "Black"
        }
      ],
      "default": "900"
    },
    {
      "type": "range",
      "id": "input_font_size",
      "label": "Input Font Size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "button_font_size",
      "label": "Button Font Size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },

    {
      "type": "header",
      "content": "Input & Button Sizing"
    },
    {
      "type": "range",
      "id": "input_padding_vertical",
      "label": "Input/Button Vertical Padding",
      "min": 8,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "input_padding_horizontal",
      "label": "Input Horizontal Padding",
      "min": 10,
      "max": 50,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "button_padding_horizontal",
      "label": "Button Horizontal Padding",
      "min": 20,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Inline Password Form",
      "category": "Password Page"
    }
  ]
}
{% endschema %}
