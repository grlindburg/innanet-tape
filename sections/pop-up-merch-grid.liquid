<section class="pop-up-merch" style="background-color: {{ section.settings.bg_color }}; padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="pop-up-merch__inner">
    {% if section.settings.heading != blank %}
      <h2 class="pop-up-merch__heading" style="color: {{ section.settings.heading_color }}; font-size: {{ section.settings.heading_size_desktop }}px;">{{ section.settings.heading }}</h2>
    {% endif %}

    {% if section.settings.show_in_store_label and section.settings.in_store_label != blank %}
      <p class="pop-up-merch__store-label" style="color: {{ section.settings.label_color }};">{{ section.settings.in_store_label }}</p>
    {% endif %}

    <div class="pop-up-merch__grid" style="--columns-desktop: {{ section.settings.columns_desktop }};">
      {% for block in section.blocks %}
        {% assign product = block.settings.product %}
        <div class="pop-up-merch__item" {{ block.shopify_attributes }}>
          {% if product != blank %}
            <div class="pop-up-merch__image-wrapper">
              {% if product.featured_media != blank %}
                <img
                  src="{{ product.featured_media | image_url: width: 600 }}"
                  srcset="{{ product.featured_media | image_url: width: 300 }} 300w,
                          {{ product.featured_media | image_url: width: 450 }} 450w,
                          {{ product.featured_media | image_url: width: 600 }} 600w"
                  sizes="(min-width: 768px) calc(100vw / {{ section.settings.columns_desktop }}), 50vw"
                  alt="{{ product.featured_media.alt | default: product.title | escape }}"
                  loading="lazy"
                  class="pop-up-merch__image"
                >
              {% else %}
                {{ 'product-1' | placeholder_svg_tag: 'pop-up-merch__placeholder' }}
              {% endif %}
            </div>
            <div class="pop-up-merch__info">
              <h3 class="pop-up-merch__title" style="color: {{ section.settings.text_color }};">{{ product.title }}</h3>
              <span class="pop-up-merch__price" style="color: {{ section.settings.text_color }};">{{ product.price | money }}</span>
            </div>
          {% else %}
            <div class="pop-up-merch__image-wrapper">
              {{ 'product-1' | placeholder_svg_tag: 'pop-up-merch__placeholder' }}
            </div>
            <div class="pop-up-merch__info">
              <h3 class="pop-up-merch__title" style="color: {{ section.settings.text_color }};">Product Title</h3>
              <span class="pop-up-merch__price" style="color: {{ section.settings.text_color }};">$0.00</span>
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<style>
  .pop-up-merch {
    width: 100%;
    padding-left: 40px;
    padding-right: 40px;
  }

  .pop-up-merch__inner {
    max-width: 1200px;
    margin: 0 auto;
  }

  .pop-up-merch__heading {
    font-family: var(--font_header), sans-serif;
    font-weight: 400;
    text-align: center;
    margin: 0 0 8px 0;
  }

  .pop-up-merch__store-label {
    font-family: var(--font_body), sans-serif;
    font-size: 12px;
    letter-spacing: 2px;
    text-transform: uppercase;
    text-align: center;
    margin: 0 0 40px 0;
    opacity: 0.6;
  }

  .pop-up-merch__grid {
    display: grid;
    grid-template-columns: repeat(var(--columns-desktop), 1fr);
    gap: 32px 24px;
  }

  .pop-up-merch__item {
    display: flex;
    flex-direction: column;
  }

  .pop-up-merch__image-wrapper {
    position: relative;
    overflow: hidden;
    aspect-ratio: 1 / 1;
    background-color: #f0f0f0;
  }

  .pop-up-merch__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .pop-up-merch__item:hover .pop-up-merch__image {
    transform: scale(1.03);
  }

  .pop-up-merch__placeholder {
    width: 100%;
    height: 100%;
  }

  .pop-up-merch__info {
    padding-top: 12px;
    text-align: center;
  }

  .pop-up-merch__title {
    font-family: var(--font_body), sans-serif;
    font-size: 14px;
    font-weight: 400;
    margin: 0 0 4px 0;
  }

  .pop-up-merch__price {
    font-family: var(--font_body), sans-serif;
    font-size: 13px;
    opacity: 0.7;
  }

  @media screen and (max-width: 768px) {
    .pop-up-merch {
      padding-left: 20px;
      padding-right: 20px;
    }

    .pop-up-merch__heading {
      font-size: {{ section.settings.heading_size_mobile }}px !important;
    }

    .pop-up-merch__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 24px 16px;
    }

    .pop-up-merch__store-label {
      margin-bottom: 28px;
    }
  }
</style>

{% schema %}
{
  "name": "Pop-Up Merch Grid",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What's There"
    },
    {
      "type": "checkbox",
      "id": "show_in_store_label",
      "label": "Show In-Store Label",
      "default": true
    },
    {
      "type": "text",
      "id": "in_store_label",
      "label": "In-Store Label Text",
      "default": "Available in-store only"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns (Desktop)",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f7f5ec"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#191818"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#191818"
    },
    {
      "type": "color",
      "id": "label_color",
      "label": "In-Store Label Color",
      "default": "#191818"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top Padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom Padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_size_desktop",
      "label": "Heading Size (Desktop)",
      "min": 18,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading Size (Mobile)",
      "min": 16,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 24
    }
  ],
  "blocks": [
    {
      "type": "product_item",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Pop-Up Merch Grid",
      "category": "Pop-Up Shop"
    }
  ]
}
{% endschema %}
