{% comment %}
  Renders form validation errors inside an alert region so assistive tech
  announces them and users can find them (WCAG 3.3.1 / 4.1.3).
  Expects `form_errors` (or a form object exposing `.errors`) in scope.
{% endcomment %}
{% if form_errors %}
  <div class="form-errors" role="alert" tabindex="-1">
    <h2 class="form-errors__title visually-hidden">{{ 'general.accessibility.error_heading' | t }}</h2>
    <ul class="form-errors__list">
      {% for field in form_errors %}
        <li>
          {% if field == 'form' %}
            {{ form_errors.messages[field] }}
          {% else %}
            {{ form_errors.translated_fields[field] }} - {{ form_errors.messages[field] }}
          {% endif %}
        </li>
      {% endfor %}
    </ul>
  </div>
{% endif %}
