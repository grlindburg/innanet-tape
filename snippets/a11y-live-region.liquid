{% comment %}
  Global ARIA live regions for status messages (WCAG 4.1.3).
  Rendered once in layout/theme.liquid. Announce via window.announce(msg)
  (polite) or window.announce(msg, 'assertive'). See assets/a11y-helpers.js.
{% endcomment %}
<div id="a11y-status" class="visually-hidden" role="status" aria-live="polite" aria-atomic="true"></div>
<div id="a11y-status-assertive" class="visually-hidden" role="alert" aria-live="assertive" aria-atomic="true"></div>
