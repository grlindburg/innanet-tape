{%- if canonical_url != blank  -%}
<link rel="canonical" href="{{ canonical_url }}">
{%- endif -%}

{%- comment -%} Favicons come from layout/theme.liquid (INNANET set). {%- endcomment -%}

{%- capture seo_title -%}
{%- if request.page_type == 'search' and search.performed == true -%}
  {{ 'general.search.heading' | t: count: search.results_count }}: {{ 'general.search.results_with_count' | t: terms: search.terms, count: search.results_count }}
{%- elsif request.page_type == 'index' -%}
  Vic Mensa &ndash; INNANETAPE
{%- else -%}
  {{ page_title }}
{%- endif -%}

{%- if current_page != 1 -%}
  &ndash; {{ 'general.meta.page' | t: page: current_page }}
{%- endif -%}
{%- assign escaped_page_title = page_title | escape -%}
{%- if request.page_type == 'index' -%}{%- assign escaped_page_title = shop.name -%}{%- endif -%}
{%- unless escaped_page_title contains shop.name -%}
  &ndash; {{ shop.name }}
{%- endunless -%}
{%- endcapture -%}
<title>{{ seo_title | strip }}{%- if current_tags -%}{% assign meta_tags = current_tags | join: ', ' %} &ndash; {{ 'general.meta.tags' | t: tags: meta_tags }}{%- endif -%}</title>

{%- if page_description -%}
<meta name="description" content="{{ page_description | escape }}">
{%- endif -%}

{%- if request.page_type == 'product' and settings.enable_product_rich_snippets -%}
  {% render "product-rich-snippets" %}
{%- endif -%}
  {%- if request.page_type == 'article' and settings.enable_article_rich_snippets -%}
    {% render "article-rich-snippets" %}
  {%- endif -%}
